{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "declaration": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
